# STARK // EDITH CLOUD DESKTOP ENVIRONMENT CONFIGURATION

# 1. Admin Authentication Credentials (Configure these in Vercel Project Settings)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=stark2026!
SESSION_SECRET=stark_industries_quantum_key_2026_super_secure

# 2. Storage Allocation (in Gigabytes)
STORAGE_CAPACITY_GB=15

# 3. Storage Provider Mode: auto | supabase | r2 | local
# Leave blank or set to 'auto' to automatically detect credentials
STORAGE_PROVIDER=auto

# 4. Option A: Supabase Cloud Storage (Recommended for Vercel)
# Set these in Vercel to activate permanent Supabase bucket storage
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_BUCKET=personal-cloud

# 5. Option B: Cloudflare R2 / AWS S3 Cloud Storage
# S3_ENDPOINT=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_r2_access_key_id
# S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
# S3_BUCKET_NAME=personal-cloud
# S3_REGION=auto
